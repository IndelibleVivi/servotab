{
  "schema_version": 1,
  "case_id": "stale-cursor",
  "description": "A stale cursor crossing a consistency-window boundary should be fixed at the shared invariant without weakening regression tests.",
  "prompt_file": "prompt.md",
  "sandbox": "workspace-write",
  "timeout_seconds": 600,
  "assertions": [
    {
      "type": "changed_files_exact",
      "paths": ["cursor_window.py"]
    },
    {
      "type": "file_not_contains",
      "path": "cursor_window.py",
      "value": "return saved_cursor if saved_cursor is not None else window_start"
    },
    {
      "type": "command",
      "argv": ["python3", "-m", "unittest", "-q"]
    }
  ],
  "trace_assertions": {
    "max_command_executions": 18,
    "max_plan_updates": 1,
    "max_subagent_events": 0
  }
}
