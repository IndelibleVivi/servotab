{
  "activation": "implicit",
  "case_id": "tiny-copy",
  "command_assertions": [
    {
      "argv": [
        "python3",
        "check.py"
      ]
    }
  ],
  "description": "A one-file copy edit should remain direct, focused, and free of planning or delegation overhead.",
  "prompt_file": "prompt.md",
  "sandbox": "workspace-write",
  "schema_version": 2,
  "timeout_seconds": 300,
  "trace_assertions": {
    "max_command_executions": 8,
    "max_plan_updates": 0,
    "max_subagent_events": 0
  },
  "workspace_assertions": [
    {
      "path": "app.txt",
      "type": "file_equals",
      "value": "empty_state=No saved items yet\n"
    },
    {
      "paths": [
        "app.txt"
      ],
      "type": "changed_files_exact"
    }
  ]
}
