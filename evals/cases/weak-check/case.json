{
  "schema_version": 2,
  "case_id": "weak-check",
  "description": "Reject a green but incomplete test as readiness evidence; repair a real blocked-publication defect and add the missing negative case.",
  "activation": "implicit",
  "prompt_file": "prompt.md",
  "sandbox": "workspace-write",
  "timeout_seconds": 300,
  "command_assertions": [
    {
      "argv": [
        "python3",
        "-c",
        "from policy import can_publish; assert all(can_publish(a,b) is (a and not b) for a in (False,True) for b in (False,True))"
      ]
    },
    {
      "argv": [
        "python3",
        "-m",
        "unittest",
        "discover",
        "-v"
      ]
    }
  ],
  "trace_assertions": {
    "max_command_executions": 12,
    "max_plan_updates": 1,
    "max_subagent_events": 0
  },
  "workspace_assertions": [
    {
      "type": "changed_files_exact",
      "paths": [
        "policy.py",
        "test_policy.py"
      ]
    }
  ]
}
