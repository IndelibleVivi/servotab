{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://indeliblevivi.github.io/softpowers/schemas/eval-result.schema.json",
  "title": "Softpowers behavior eval attempt result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "state",
    "outcome",
    "run_id",
    "case_id",
    "subject_id",
    "repeat",
    "started_at",
    "updated_at",
    "inputs",
    "runner",
    "execution",
    "artifacts"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "state": {
      "enum": ["running", "completed"]
    },
    "outcome": {
      "enum": ["pending", "pass", "fail", "error", "timeout"]
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "subject_id": {
      "type": "string",
      "minLength": 1
    },
    "repeat": {
      "type": "integer",
      "minimum": 1
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_sha256", "fixture_tree", "prompt_sha256"],
      "properties": {
        "case_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "fixture_tree": {
          "type": "string",
          "pattern": "^[0-9a-f]{40,64}$"
        },
        "prompt_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "runner": {
      "type": "object"
    },
    "execution": {
      "type": "object"
    },
    "artifacts": {
      "type": "object"
    }
  }
}
