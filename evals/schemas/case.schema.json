{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://indeliblevivi.github.io/softpowers/schemas/eval-case.schema.json",
  "title": "Softpowers behavior eval case",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_id",
    "description",
    "prompt_file",
    "sandbox",
    "timeout_seconds",
    "assertions"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "case_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "prompt_file": {
      "type": "string",
      "pattern": "^[^/]+\\.md$"
    },
    "sandbox": {
      "enum": ["read-only", "workspace-write"]
    },
    "timeout_seconds": {
      "type": "integer",
      "minimum": 30,
      "maximum": 3600
    },
    "assertions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "path", "value"],
            "properties": {
              "type": {
                "enum": ["file_equals", "file_contains", "file_not_contains"]
              },
              "path": {
                "type": "string",
                "minLength": 1
              },
              "value": {
                "type": "string"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "path"],
            "properties": {
              "type": {
                "const": "file_exists"
              },
              "path": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "paths"],
            "properties": {
              "type": {
                "const": "changed_files_exact"
              },
              "paths": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "argv"],
            "properties": {
              "type": {
                "const": "command"
              },
              "argv": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              },
              "exit_code": {
                "type": "integer",
                "default": 0
              },
              "timeout_seconds": {
                "type": "integer",
                "minimum": 1,
                "maximum": 300,
                "default": 30
              }
            }
          }
        ]
      }
    },
    "trace_assertions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_command_executions": {
          "type": "integer",
          "minimum": 0
        },
        "max_plan_updates": {
          "type": "integer",
          "minimum": 0
        },
        "max_subagent_events": {
          "type": "integer",
          "minimum": 0
        },
        "reference_reads_include": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    }
  }
}
