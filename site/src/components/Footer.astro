---
import BrandMark from "./BrandMark.astro";
import { PROJECT_LINKS, repoFile } from "../config";
---

<footer class="site-footer">
  <div class="shell footer-grid">
    <div class="footer-identity">
      <a class="brand-lockup" href="/" aria-label="Servotab home">
        <BrandMark size={28} />
        <span>servotab</span>
      </a>
      <p>
        Engineering method layer for Codex.
        <span class="footer-maker">Created by Faye &amp; Cove. Maintained by <a href="https://github.com/IndelibleVivi">Faye</a>.</span>
      </p>
    </div>

    <nav class="footer-links" aria-label="Product links">
      <span>Product</span>
      <a href="/docs">Docs</a>
      <a href="/methods">Methods</a>
      <a href={PROJECT_LINKS.pluginDirectory}>OpenAI listing</a>
      <a href="/lineage">Lineage</a>
      <a href={repoFile("CHANGELOG.md")}>Changelog</a>
    </nav>

    <nav class="footer-links" aria-label="Project links">
      <span>Project</span>
      <a href={PROJECT_LINKS.source}>Source</a>
      <a href={PROJECT_LINKS.issues}>Issues</a>
      <a href="/support">Support</a>
      <a href={PROJECT_LINKS.securityPolicy}>Security</a>
      <a href={repoFile("CONTRIBUTING.md")}>Contribute</a>
    </nav>

    <nav class="footer-links" aria-label="Legal links">
      <span>Legal</span>
      <a href="/privacy">Privacy</a>
      <a href="/terms">Terms</a>
    </nav>
  </div>
  <div class="shell footer-base">
    <p>Independent and community-maintained. Available in OpenAI Plugins; not an official OpenAI product.</p>
    <p>servotab.com</p>
  </div>
</footer>
