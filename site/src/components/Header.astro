---
import BrandMark from "./BrandMark.astro";

type Props = {
  pathname: string;
};

const { pathname } = Astro.props;

const links = [
  { href: "/docs", label: "Docs" },
  { href: "/methods", label: "Methods" },
  { href: "/lineage", label: "Lineage" },
];

const isCurrent = (href: string) => pathname === href || pathname.startsWith(`${href}/`);
---

<header class="site-header">
  <div class="shell header-inner">
    <a class="brand-lockup" href="/" aria-label="Servotab home">
      <BrandMark size={30} />
      <span>servotab</span>
    </a>

    <nav class="desktop-nav" aria-label="Primary navigation">
      {links.map((link) => (
        <a href={link.href} aria-current={isCurrent(link.href) ? "page" : undefined}>
          {link.label}
        </a>
      ))}
      <a class="nav-source" href="/support" aria-current={isCurrent("/support") ? "page" : undefined}>Support</a>
    </nav>

    <details class="mobile-nav">
      <summary>Menu<span class="mobile-nav-indicator" aria-hidden="true"></span></summary>
      <nav aria-label="Mobile navigation">
        {links.map((link) => (
          <a href={link.href} aria-current={isCurrent(link.href) ? "page" : undefined}>
            {link.label}
          </a>
        ))}
        <a href="/support" aria-current={isCurrent("/support") ? "page" : undefined}>Support</a>
      </nav>
    </details>
  </div>
</header>
