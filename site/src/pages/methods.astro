---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageIntro from "../components/PageIntro.astro";
import { repoFile } from "../config";
import { methods } from "../data/methods";
---

<BaseLayout
  title="Methods"
  description="The twelve plugin-native methods in the current Servotab source candidate, from design through verified closure."
>
  <PageIntro
    index="02 / Methods"
    title="Twelve methods. None mandatory by default."
    description="These plugin-native names describe distinct engineering pressures. Natural-language work may stay direct or route into one method; a person can also choose any method explicitly."
  />

  <section class="shell content-band methods-catalog" aria-labelledby="method-list-heading">
    <h2 id="method-list-heading" class="visually-hidden">Servotab methods</h2>
    <div class="methods-usage">
      <p><span>ordinary /</span> Describe the complete outcome normally. Servotab may keep the work direct.</p>
      <p><span>explicit /</span> Use a name such as <code>$review</code> when you want precise control.</p>
    </div>
    <div class="methods-list">
      {methods.map((method, index) => (
        <article class="method-row">
          <div class="method-key" aria-hidden="true">
            <span>{String(index + 1).padStart(2, "0")}</span>
            <img
              class="method-icon"
              src={method.icon}
              alt=""
              width="32"
              height="32"
              loading="lazy"
              decoding="async"
            />
          </div>
          <h2>
            {method.name}
            <span class="method-invocation">invoke / ${method.name}</span>
          </h2>
          <div class="method-copy">
            <p>{method.purpose}</p>
            <p>{method.signal}</p>
            <a class="method-contract" href={repoFile(`methods/${method.name}.md`)}>
              Read method contract <span class="contract-arrow" aria-hidden="true">↗</span>
            </a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="content-band" aria-labelledby="selection-heading">
    <div class="shell content-layout">
      <p class="section-index">Selection rule</p>
      <div class="content-prose">
        <h2 id="selection-heading">The risk chooses the depth.</h2>
        <p>
          Method names do not create permission or ceremony. The current task,
          repository evidence, host capability, and user authority decide what is
          useful. Clear work can still bypass the list entirely.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
